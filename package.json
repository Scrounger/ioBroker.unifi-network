{
  "name": "iobroker.unifi-network",
  "version": "1.6.2",
  "description": "Unifi Network uses the websocket interface to receive real-time information from the unifi-network application",
  "author": {
    "name": "Scrounger",
    "email": "scrounger@gmx.net"
  },
  "homepage": "https://github.com/Scrounger/ioBroker.unifi-network",
  "license": "MIT",
  "keywords": [
    "unifi",
    "network",
    "unifi-os",
    "api",
    "websocket",
    "ioBroker"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/Scrounger/ioBroker.unifi-network.git"
  },
  "engines": {
    "node": ">= 22.19"
  },
  "dependencies": {
    "@iobroker/adapter-core": "^3.4.3",
    "dayjs": "^1.11.23",
    "lodash": "^4.18.1",
    "tough-cookie": "^6.1.0",
    "undici": "^8.12.4",
    "ws": "^8.23.0"
  },
  "devDependencies": {
    "@alcalzone/release-script": "^5.2.1",
    "@alcalzone/release-script-plugin-iobroker": "^5.2.0",
    "@alcalzone/release-script-plugin-license": "^5.2.2",
    "@alcalzone/release-script-plugin-manual-review": "^5.2.0",
    "@iobroker/adapter-dev": "^1.5.0",
    "@iobroker/eslint-config": "^2.3.4",
    "@iobroker/testing": "^6.3.2",
    "@tsconfig/node22": "^22.0.7",
    "@types/lodash": "^4.17.27",
    "@types/node": "^22.20.5",
    "@types/ws": "^8.18.2",
    "c8": "^12.0.0",
    "rimraf": "^6.1.4",
    "source-map-support": "^0.5.21",
    "ts-node": "^10.9.2",
    "tsc-watch": "^7.2.1",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3"
  },
  "type": "module",
  "main": "build/main.js",
  "files": [
    "admin{,/!(src)/**}/!(tsconfig|tsconfig.*|.eslintrc).{json,json5}",
    "admin{,/!(src)/**}/*.{html,css,png,svg,jpg,js}",
    "build/",
    "www/",
    "io-package.json",
    "LICENSE"
  ],
  "scripts": {
    "prebuild": "rimraf build",
    "build": "tsc -p tsconfig.build.json",
    "build-watch": "clear && tsc-watch -p tsconfig.build.json --noClear --onSuccess 'iobroker restart unifi-network'",
    "watch": "build-adapter ts --watch",
    "prebuild:ts": "rimraf build",
    "build:ts": "build-adapter ts --typescriptFormat esm",
    "watch:ts": "build-adapter ts --watch --typescriptFormat esm",
    "test:ts": "node tools/withMyIobCopy.mjs mocha --config test/mocharc.custom.json \"test/unit/**/*.test.ts\" \"test/tools/**/*.test.ts\" --ignore \"test/tools/**/*.live.test.ts\"",
    "test:coverage": "c8 npm run test:all && node tools/updateCoverageBadge.mjs",
    "test:live": "mocha --config test/mocharc.custom.json \"test/tools/**/*.live.test.ts\" --exit",
    "test:myiob": "node tools/withMyIobCopy.mjs mocha --config test/mocharc.custom.json \"test/unit/lib/myIob.test.ts\"",
    "record:api": "tsx tools/recordApiFixtures.ts",
    "record:events": "tsx tools/recordEventFixtures.ts",
    "record:events:missing": "tsx tools/recordEventFixtures.ts --missing",
    "record:events:unknown": "tsx tools/recordUnknownEvents.ts",
    "test:package": "mocha test/package --exit",
    "test:integration": "mocha test/integration --exit",
    "test": "npm run test:ts && npm run test:package",
    "test:all": "npm run test:ts && npm run test:package && npm run test:live",
    "check": "tsc --noEmit && tsc -p tools/tsconfig.json",
    "lint": "eslint -c eslint.config.mjs .",
    "translate": "translate-adapter",
    "release": "release-script"
  },
  "bugs": {
    "url": "https://github.com/Scrounger/ioBroker.unifi-network/issues"
  },
  "readmeFilename": "README.md"
}
