# No dot-directories except github/vscode
.*/
!.vscode/
!.github/

*.code-workspace
node_modules
nbproject

# npm package files
iobroker.*.tgz
.commitinfo

Thumbs.db

# i18n intermediate files
admin/i18n/flat.txt
admin/i18n/*/flat.txt

mybuild.sh
myrelease.sh
ioBroker.unifi-network.lnk

# local environment / credentials (live tests)
.env
.env.*
!.env.example

# recorded real-time event fixtures (contain anonymized controller data, stay local)
test/fixtures/local/

# compiled tests and live tools (excluded from build, see tsconfig.build.json)
build/**/*.test.js
build/**/*.test.d.ts
build/live/

# test coverage reports (npm run test:coverage)
coverage/
